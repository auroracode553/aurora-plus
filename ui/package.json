{
  "name": "aurora-plus",
  "version": "0.1.0",
  "description": "Aurora Plus Vue 3 component library",
  "homepage": "https://auroracode553.github.io/aurora-plus/",
  "bugs": {
    "url": "https://github.com/auroracode553/aurora-plus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auroracode553/aurora-plus.git",
    "directory": "ui"
  },
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "main": "./dist/aurora-plus.umd.cjs",
  "module": "./dist/aurora-plus.js",
  "style": "./dist/aurora-plus.css",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/aurora-plus.js",
      "require": "./dist/aurora-plus.umd.cjs"
    },
    "./style.css": "./dist/aurora-plus.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.46.0"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.103.1",
    "vite": "^8.2.2",
    "vue": "^3.5.40"
  },
  "keywords": [
    "aurora",
    "aurora-plus",
    "component-library",
    "ui",
    "vue",
    "vue3"
  ]
}
