{
  "name": "aurora-ui",
  "version": "0.1.0",
  "description": "Aurora Vue 3 UI component library",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "main": "./dist/aurora-ui.umd.cjs",
  "module": "./dist/aurora-ui.js",
  "style": "./dist/aurora-ui.css",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/aurora-ui.js",
      "require": "./dist/aurora-ui.umd.cjs"
    },
    "./style.css": "./dist/aurora-ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
  ],
  "dependencies": {
    "@tabler/icons-vue": "^3.46.0"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.103.1",
    "vite": "^8.1.5",
    "vue": "^3.5.40"
  },
  "keywords": [
    "aurora",
    "component-library",
    "ui",
    "vue",
    "vue3"
  ]
}
